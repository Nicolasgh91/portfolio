---
import { localeFromPathname } from "../lib/locale-path";

const isEnglish = localeFromPathname(Astro.url.pathname) === "en";
---

<button
  type="button"
  data-back-to-top
  aria-label={isEnglish ? "Back to top" : "Volver arriba"}
  class="btn-secondary btn-secondary--icon-only pointer-events-none fixed inset-x-0 bottom-[28px] z-40 mx-auto h-[58px] w-[58px] min-h-[58px] min-w-[58px] border border-white/15 bg-black/55 text-white opacity-0 shadow-[0_8px_30px_rgba(0,0,0,0.35)] backdrop-blur-md hover:border-[color:var(--color-accent-400)]/40 hover:bg-black/65 max-[480px]:bottom-[20px]"
>
  <span aria-hidden="true" class="text-lg leading-none">↑</span>
</button>

<script>
  (() => {
    const button = document.querySelector("[data-back-to-top]");
    if (!(button instanceof HTMLButtonElement)) return;

    // Navegadores que ya muestran su propio botón "volver arriba" al hacer scroll.
    const NATIVE_BACK_TO_TOP_UA = /SamsungBrowser|MiuiBrowser/i;
    if (NATIVE_BACK_TO_TOP_UA.test(navigator.userAgent)) {
      button.remove();
      return;
    }

    const threshold = 300;

    const syncVisibility = () => {
      const isVisible = window.scrollY > threshold;
      button.classList.toggle("opacity-0", !isVisible);
      button.classList.toggle("pointer-events-none", !isVisible);
    };

    button.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    window.addEventListener("scroll", syncVisibility, { passive: true });
    syncVisibility();
  })();
</script>
